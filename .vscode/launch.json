    "version": "0.2.0",
    "configurations": [
      {
        "type": "lldb",
        "request": "launch",
        "name": "(lldb)demo_cnot",
        "program": "${workspaceFolder}/build/apps/orgnl",
        "args": [
              "./circuits/demo_cnot.real"
        ],
        "cwd": "${workspaceFolder}"
      },
      {
        "type": "lldb",
        "request": "launch",
        "name": "(lldb)new sifting algo",
        "program": "${workspaceFolder}/build/apps/main",
        "args": [
          // "${workspaceFolder}/circuits/demo_cnot.real"
          // "${workspaceFolder}/circuits/demo2.real"
          // "${workspaceFolder}/circuits/demo4.real"
          // "${workspaceFolder}/circuits/revLib/apex4_202.real",
          "${workspaceFolder}/circuits/revLib/alu4_201.real"
          // "${workspaceFolder}/circuits/revLib/urf1_278.real"
        ],
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "(gdb)new sifting algo",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/apps/main",
        "args": [
          // "${workspaceFolder}/circuits/demo_cnot.real"
          // "${workspaceFolder}/circuits/revLib/apex4_202.real"
          // "${workspaceFolder}/circuits/revLib/alu4_201.real"
          // "${workspaceFolder}/circuits/demo3.real"
          // "${workspaceFolder}/circuits/demo4.real"
          "${workspaceFolder}/circuits/benchmark/QASMBenchFilter/seca_n11.qasm"
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      },

      {
        "type": "lldb",
        "request": "launch",
        "name": "gtest",
        "program": "${workspaceFolder}/build/test/dynmic/mnodepar-test",
        "args": [],
        "cwd": "${workspaceFolder}"
      },

      {
        "name": "demo2",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/apps/orgnl",
        "args": [
          "./circuits/demo2.real"
        ],
        "stopAtEntry": true,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      },

        {
            "type": "lldb",
            "request": "launch",
            "name": "demo2(lldb)",
            "program": "${workspaceFolder}/build/apps/orgnl",
            "args": [
              "./circuits/demo2.real"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
